# Скопируй в .env (в той же папке что bot_v2.py) и заполни.
# `chmod 600 .env` обязательно.

# ---------- Bybit ----------
# https://www.bybit.com/app/user/api-management (или testnet.bybit.com для теста)
# Права: Read + Trade. БЕЗ Withdraw. Только для USDT-perpetual (linear).
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ---------- Telegram ----------
# @BotFather -> /newbot -> токен
TG_TOKEN=
# Напиши боту /start, потом https://api.telegram.org/bot<TOKEN>/getUpdates -> chat.id
TG_CHAT_ID=

# ---------- Trading ----------
BOT_SYMBOL=BTCUSDT
BOT_CATEGORY=linear         # linear (USDT perp) — единственный поддерживаемый
BOT_INTERVAL=15             # 1, 3, 5, 15, 30, 60, 120, 240, 360, 720, D
BOT_LEVERAGE=5              # плечо
BOT_MARGIN_USDT=10          # СКОЛЬКО $ ЗАЛОГА; нотионал = margin × leverage

# ---------- Strategy ----------
BOT_EMA_PERIOD=20
BOT_ATR_PERIOD=14
BOT_VOL_PERIOD=20
BOT_VOL_MULT=1.5            # объём последней свечи > avg × этого = вход
BOT_TP_ATR_MULT=1.5         # TP = entry + 1.5 * ATR (long), -1.5*ATR (short)
BOT_SL_ATR_MULT=1.0         # SL = entry - 1.0 * ATR (long), +1.0*ATR (short)
BOT_SPREAD_MAX_PCT=0.05     # пропуск если (ask-bid)/mid > 0.05%

# ---------- Risk ----------
BOT_MAX_DAILY_LOSS_USDT=3.0 # реально считается из closed PnL Bybit
BOT_MAX_TRADES_PER_DAY=5

# ---------- Misc ----------
BOT_TZ=UTC                  # для дневного reset (пример: Europe/Moscow)
BOT_TESTNET=true            # ОБЯЗАТЕЛЬНО оставь true пока не протестировал!
BOT_DRY_RUN=false           # true = не отправлять ордер, только логировать
